; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Launch Compound: Starship Ark"
config/description="A post-modern espionage and survival deduction simulation game."
config/tags=PackedStringArray("simulation", "deduction", "sci-fi")
run/main_scene="res://scenes/SecurityDesk.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/GameState.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
